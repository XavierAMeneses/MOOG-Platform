# .gitignore for Unreal Engine 5 Projects

# Core Engine/Project Folders to Ignore
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Ignore all map build data (these can be regenerated and are often large)
*_BuiltData.uasset

# Ignore project files generated by the Engine (you can always right-click the .uproject to regenerate these)
*.sln
*.suo
*.xcodeproj
*.xcworkspace
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.ignore
*.enc_temp_folder/

# Visual Studio and IDE specific files
.vs/
.idea/
.vscode/
*.code-workspace

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Optional: If you use Plugins, ignore their generated folders too
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/Saved/

# Exceptions (Files we actually DO want to keep in the Build folder)
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico


# -------------------------------------------------------------------------
# EXPLICIT EXCEPTIONS FOR AIRacer DIRECTORIES
# -------------------------------------------------------------------------

# 1. Un-ignore the specific parent directories so Git is allowed to look inside them
!Unreal_Projects/AIRacer/Intermediate/
!Unreal_Projects/AIRacer/Saved/

# 2. Re-ignore everything inside those directories by default
Unreal_Projects/AIRacer/Intermediate/*
Unreal_Projects/AIRacer/Saved/*

# 3. Whitelist the target folders AND recursively whitelist all their contents (**)
!Unreal_Projects/AIRacer/Intermediate/LearningAgents/
!Unreal_Projects/AIRacer/Intermediate/LearningAgents/**

!Unreal_Projects/AIRacer/Saved/StagedBuilds/
!Unreal_Projects/AIRacer/Saved/StagedBuilds/**


# Ignore massive final build artifacts inside whitelisted folders
*.pdb
*.exe
*.ushaderbytecode


enc_temp_folder/